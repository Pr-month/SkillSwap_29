	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"requests": {},
				"exec": [
					"// This script runs before each request in the collection.",
					"// It checks if the access token is expired and refreshes it if needed.",
					"// NOTE: Due to a Postman limitation, the first request after a token expires might fail.",
					"// The token will be refreshed in the background. Simply send the request again.",
					"",
					"const expiresAt = pm.environment.get(\"accessTokenExpiresAt\");",
					"const refreshToken = pm.environment.get(\"refreshToken\");",
					"",
					"if (expiresAt && refreshToken) {",
					"    const now = new Date().getTime();",
					"    if (now > parseInt(expiresAt)) {",
					"        console.log(\"Access token expired. Refreshing...\");",
					"        pm.sendRequest({",
					"            url: pm.environment.get(\"baseUrl\") + '/auth/refresh',",
					"            method: 'POST',",
					"            header: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + refreshToken }",
					"        }, (err, res) => {",
					"            if (err) {",
					"                console.error(\"Error refreshing token:\", err);",
					"            } else if (res.code === 200) {",
					"                const newTokens = res.json();",
					"                pm.environment.set(\"accessToken\", newTokens.accessToken);",
					"                pm.environment.set(\"refreshToken\", newTokens.refreshToken);",
					"                const newExpiryTime = new Date().getTime() + 59 * 60 * 1000;",
					"                pm.environment.set(\"accessTokenExpiresAt\", newExpiryTime);",
					"                console.log(\"Token refreshed successfully. Please send your request again.\");",
					"            } else {",
					"                console.error(`Failed to refresh token. Status: ${res.code}, Response: ${res.text()}`);",
					"            }",
					"        });",
					"    }",
					"}"
				]
			}
		},
