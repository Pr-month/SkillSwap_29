		{
			"name": "WebSocket: Skill Exchange Scenario",
			"item": [
				{
					"name": "1. Login as Ivan (Sender)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const response = pm.response.json();",
									"if (response.accessToken && response.user.id) {",
									"    pm.collectionVariables.set(\"user_a_token\", response.accessToken);",
									"    pm.collectionVariables.set(\"user_a_id\", response.user.id);",
									"}"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						},
						{
							"listen": "prerequest",
							"script": {
								"exec": [],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"{{user_a_email}}\",\n    \"password\": \"{{user_a_password}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "http://{{host}}/auth/login",
							"protocol": "http",
							"host": [
								"{{host}}"
							],
							"path": [
								"auth",
								"login"
							]
						}
					},
					"response": []
				},
				{
					"name": "2. Login as Anna (Receiver)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const response = pm.response.json();",
									"if (response.accessToken && response.user.id) {",
									"    pm.collectionVariables.set(\"user_b_token\", response.accessToken);",
									"    pm.collectionVariables.set(\"user_b_id\", response.user.id);",
									"}"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						},
						{
							"listen": "prerequest",
							"script": {
								"exec": [],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"{{user_b_email}}\",\n    \"password\": \"{{user_b_password}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "http://{{host}}/auth/login",
							"protocol": "http",
							"host": [
								"{{host}}"
							],
							"path": [
								"auth",
								"login"
							]
						}
					},
					"response": []
				},
				{
					"name": "3. Get Ivan's Skills",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const skills = pm.response.json();",
									"",
									"if (skills && skills.length > 0) {",
									"    const skillId = skills[0].id;",
									"    pm.collectionVariables.set(\"user_a_skill_id\", skillId);",
									"    console.log(`Навык Ивана (ID: ${skillId}) сохранен.`);",
									"} else {",
									"    console.error(\"Не удалось найти навыки для Ивана. Убедитесь, что seed-скрипты были запущены.\");",
									"}"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						},
						{
							"listen": "prerequest",
							"script": {
								"exec": [],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{user_a_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{user_a_token}}"
							}
						],
						"url": {
