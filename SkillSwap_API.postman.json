				{
					"name": "Login Admin",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.accessToken && jsonData.refreshToken) {",
									"    pm.collectionVariables.set(\"accessToken\", jsonData.accessToken);",
									"    pm.collectionVariables.set(\"refreshToken\", jsonData.refreshToken);",
									"    ",
									"    // Token expires in 3600s (1 hour). Let's set expiry for 59 minutes.",
									"    var expiryTime = new Date().getTime() + 59 * 60 * 1000;",
									"    pm.collectionVariables.set(\"accessTokenExpiresAt\", expiryTime);",
									"}"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						},
						{
							"listen": "prerequest",
							"script": {
								"exec": [],
