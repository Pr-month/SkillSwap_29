# Настройки окружения
NODE_ENV=development
HOST=localhost
PORT=3000

# WebSocket настройки
NOTIFICATIONS_WS_PORT=3001
# CHAT_WS_PORT=3002

# Настройки подключения к PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=skillswap
DB_USER=postgres
DB_PASSWORD=postgres

#JWT
JWT_ACCESS_SECRET=access_secret_123
JWT_REFRESH_SECRET=refresh_secret_456
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT=10

# Ограничения загружаемых файлов
LIMIT_FILE_SIZE=2097152
ALLOWED_MIME_TYPES=image/jpeg,image/png

# Креды админа
ADMIN_EMAIL=admin@skillswap.com
ADMIN_PASSWORD=admin123
