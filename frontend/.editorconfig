# EditorConfig помогает поддерживать единый стиль кода в разных редакторах и IDE
# https://editorconfig.org

# Указывает, что это корневой файл конфигурации
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false
